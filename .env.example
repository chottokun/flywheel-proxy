# Routing Configuration
ROUTER_TYPE=logit_router
ROUTER_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ROUTER_DEVICE=cuda
ROUTER_TORCH_DTYPE=bfloat16

# Uncertainty Thresholds
ENTROPY_THRESHOLD=0.35
MARGIN_THRESHOLD=0.80

# Backend Endpoints (Dummy / Local placeholders)
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=qwen2.5-14b-instruct
LOCAL_LLM_API_KEY=EMPTY

COMMERCIAL_FAST_URL=https://generativelanguage.googleapis.com/v1beta/openai
COMMERCIAL_FAST_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

COMMERCIAL_EXPERT_URL=https://api.openai.com/v1
COMMERCIAL_EXPERT_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# Network Settings
HTTP_TIMEOUT_SECONDS=120.0
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
HTTP_MAX_KEEP_ALIVE_CONNECTIONS=100
HTTP_MAX_CONNECTIONS=200

# Storage
DB_PATH=data/transactions.db
